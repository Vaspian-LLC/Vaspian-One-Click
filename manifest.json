{
  "manifest_version": 3,
  "name": "Vaspian One Click",
  "version": "2.0.1",
  "minimum_chrome_version": "116",
  "description": "Works with your Vaspian desk phone. Call and transfer from Chrome, pop callers into your CRM and see your team at a glance.",
  "permissions": [
    "storage",
    "cookies",
    "sidePanel",
    "alarms",
    "contextMenus"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://xtone.buf.vaspian.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "answer": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Answer the ringing call"
    },
    "hangup": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Hang up the active call"
    },
    "toggle-dnd": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn Do not disturb on or off"
    },
    "dial-selection": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Call the selected phone number"
    }
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
